# Local-only planning and working documentation.
/docs/_local/

# Local Go build outputs.
/bin/
/dist/

# Legacy root-level build outputs remain ignored.
*.exe
*.exe~
*.dll
*.so
*.dylib

# Go test, coverage, profiling, and debugger outputs.
*.test
*.coverprofile
/coverage/
/coverage.out
/coverage.html
/profiles/
__debug_bin*

# The root go.work is tracked; only its generated checksum file is local.
/go.work.sum

/tmp/

# Operating-system metadata.
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# CI-only dependency checkouts.
/_ci/
